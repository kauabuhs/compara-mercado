# Cada aplicação tem o próprio arquivo de ambiente (copie o trecho correspondente):
#   frontend/.env.local            ← seção FRONT-END
#   backend/apps/api/.env          ← seção API
#   backend/apps/worker/.env       ← seção WORKER
# NUNCA versione valores reais. Cada ambiente (local, staging, produção) tem projeto Supabase
# e chaves próprios. Valores locais vêm de `pnpm exec supabase status --workdir backend`.

# ═══ FRONT-END (frontend/.env.local) ═══════════════════════════════════════════
# Só chaves PÚBLICAS: o front-end nunca recebe segredo do back-end.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL da API do back-end, acessada só pelo servidor do Next (obrigatória em produção;
# em desenvolvimento o padrão é http://127.0.0.1:4000).
API_URL=http://127.0.0.1:4000

# ═══ API (backend/apps/api/.env) ═══════════════════════════════════════════════
# A API usa a chave pública (anon) e o token do próprio usuário: nunca service_role.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
API_PORT=4000
API_HOST=127.0.0.1        # em container use 0.0.0.0
LOG_LEVEL=info

# ═══ WORKER (backend/apps/worker/.env) ═════════════════════════════════════════
# SECRETO: só o worker conhece service_role. Nunca no navegador nem na API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta ao Postgres, usada pelo pg-boss
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# IA (decisão em aberto: provedor/modelo — ver ADR-0001)
AI_PROVIDER=fake            # fake | anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_CENTS=20000   # teto mensal de gasto com IA (R$ 200)
PUBLISH_CONFIDENCE_THRESHOLD=0.9
PORT=8080

# ═══ Observabilidade (planejado, Fase 4) ═══════════════════════════════════════
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
