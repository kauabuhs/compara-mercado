{
  "name": "@compara/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP do Compara Mercado (v1): leitura pública, comparação de lista e administração.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@compara/contracts": "workspace:*",
    "@compara/db": "workspace:*",
    "@compara/domain": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@compara/config": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
