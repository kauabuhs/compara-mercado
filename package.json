{
  "name": "compara-mercado",
  "version": "0.0.0",
  "private": true,
  "description": "Comparador de preços de supermercados — em qual mercado da minha cidade a minha lista sai mais barata hoje?",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=comparamercado-front --filter=comparamercado-back",
    "dev:front": "pnpm --filter comparamercado-front dev",
    "dev:back": "pnpm --filter comparamercado-back dev",
    "dev:worker": "pnpm --filter comparamercado-back dev:worker",
    "dev:abas": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-abas.ps1",
    "build": "turbo run build",
    "build:front": "pnpm --filter comparamercado-front build",
    "build:back": "pnpm --filter comparamercado-back build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "arch:check": "node scripts/check-architecture.mjs",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "pnpm lint && pnpm arch:check && pnpm typecheck && pnpm test",
    "db:start": "supabase start --workdir ComparaMercado-Back",
    "db:stop": "supabase stop --workdir ComparaMercado-Back",
    "db:reset": "supabase db reset --workdir ComparaMercado-Back",
    "db:test": "supabase test db --workdir ComparaMercado-Back",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:schema": "pnpm --filter comparamercado-back db:schema",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "supabase": "^3.0.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
