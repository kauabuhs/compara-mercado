{
  "name": "comparamercado-back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Back-end do Compara Mercado: API HTTP (Hono), worker de ingestão/jobs (pg-boss) e o projeto Supabase (supabase/).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "build": "pnpm run build:api && pnpm run build:worker",
    "build:api": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/index.js",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --format=esm --target=node24 --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/worker.js",
    "db:schema": "node scripts/gen-db-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@hono/node-server": "^2.1.6",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.16",
    "pg": "8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
